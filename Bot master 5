                  <block type="trade_definition_candleinterval" id="interval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuystrat" id="restart">
                        <value name="TIME_MACHINE_ENABLED">
                          <block type="logic_boolean" id="tm">
                            <field name="BOOL">FALSE</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_consec_even">
        <field name="VAR">consecutive_even</field>
        <value name="VALUE">
          <block type="math_number" id="n1"><field name="NUM">0</field></block>
        </value>
